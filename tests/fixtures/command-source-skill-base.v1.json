{
  "schema": "guard.command-extension-fixtures.v1",
  "build": {
    "schema": "guard.command-extension-build.v1",
    "base": "packaged",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.skill-base",
          "version": "1.0.0",
          "name": "Skill Base CLI",
          "description": "Reviews authenticated Skill Base CLI publications before local Skill files are uploaded as a new version.",
          "action_classes": [
            "Skill Base publication"
          ],
          "risk_classes": [
            "data_flow_exfiltration",
            "execution",
            "network_egress"
          ],
          "safer_alternatives": [
            "Inspect the exact Skill directory and its files before publishing; there is no dry-run option."
          ],
          "reference_urls": [
            "https://github.com/ginuim/skill-base/blob/main/cli/lib/commands/publish.js",
            "https://github.com/ginuim/skill-base/blob/main/docs/zh/cli.md"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "ecosystem_ids": [],
          "executables": [
            "skb",
            "skb.cmd",
            "skb.exe"
          ],
          "project_markers": [],
          "publisher": {
            "id": "ginuim",
            "display_name": "Skill Base",
            "url": "https://github.com/ginuim/skill-base"
          },
          "homepage": "https://github.com/ginuim/skill-base",
          "icon": {
            "kind": "none"
          },
          "license": "MIT",
          "permissions": [
            {
              "permission_id": "command.skill-base.permission.publish",
              "implementation_version": "1.0.0",
              "label": "Publish a Skill version",
              "description": "Reviews upload of a local Skill directory to Skill Base, where it creates a public Skill or publishes a new version.",
              "risk_tier": "high",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Skill Base publication"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Confirm the directory, Skill ID, and files that will be uploaded.",
                "Check the name, description, and changelog flags; new Skills are public by default."
              ],
              "example_command": "skb publish ./my-skill --changelog 'Initial release'"
            }
          ],
          "rules": [
            {
              "rule_id": "command.skill-base.publish",
              "rule_version": "1.0.0",
              "permission_id": "command.skill-base.permission.publish",
              "title": "Skill Base publication",
              "description": "Identifies `skb publish`, which packages the selected local directory and uploads it with the saved Skill Base credential to create a Skill or publish a new version.",
              "severity": "high",
              "risk_classes": [
                "data_flow_exfiltration",
                "execution",
                "network_egress"
              ],
              "action_classes": [
                "Skill Base publication"
              ],
              "safer_alternatives": [
                "Inspect the exact Skill directory and its files before publishing; there is no dry-run option."
              ],
              "default_mode": "review",
              "matcher": {
                "op": "executable.v1",
                "config": {
                  "executables": [
                    "skb",
                    "skb.cmd",
                    "skb.exe"
                  ],
                  "subcommands": [
                    "publish"
                  ],
                  "allow_leading_options": true,
                  "leading_options_with_values": [
                    "--changelog",
                    "--description",
                    "--name"
                  ],
                  "interspersed_options_with_values": [
                    "--changelog",
                    "--description",
                    "--name"
                  ],
                  "interspersed_flags": [
                    "--help",
                    "-h"
                  ],
                  "fail_secure_unknown_options": true,
                  "required_flags": [],
                  "required_flags_in_all_arguments": false,
                  "required_option_values": [],
                  "forbidden_flags": [],
                  "inverse_flag_pairs": []
                }
              },
              "safe_variants": [
                {
                  "variant_id": "help",
                  "title": "Publish command help (--help)",
                  "matcher": {
                    "op": "reviewed-literal.v1",
                    "config": {
                      "executable": "skb",
                      "arguments": [
                        "publish",
                        "--help"
                      ]
                    }
                  }
                },
                {
                  "variant_id": "short-help",
                  "title": "Publish command help (-h)",
                  "matcher": {
                    "op": "reviewed-literal.v1",
                    "config": {
                      "executable": "skb",
                      "arguments": [
                        "publish",
                        "-h"
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "mcp_sources": [],
    "trust": {
      "schemaVersion": "guard.extension-trust-class-map.v1",
      "publishers": {
        "hol": {
          "id": "hol",
          "displayName": "Hashgraph Online"
        },
        "hol-curated": {
          "id": "hol-curated",
          "displayName": "HOL curated library"
        }
      },
      "classes": {
        "first-party": [
          "command.container-runtime",
          "command.data-protection",
          "command.encoded-execution",
          "command.filesystem",
          "command.git",
          "command.guard-self-protection",
          "command.kubernetes-secrets",
          "command.package.go",
          "command.package.jvm",
          "command.package.node",
          "command.package.php",
          "command.package.python",
          "command.package.ruby",
          "command.package.rust",
          "command.package.system",
          "command.shell-mutations",
          "command.system",
          "command.windows"
        ],
        "trusted-library": [
          "command.api-gateway",
          "command.backup.borg",
          "command.backup.rclone",
          "command.backup.restic",
          "command.backup.velero",
          "command.cdn",
          "command.cicd.circleci",
          "command.cicd.github",
          "command.cicd.gitlab",
          "command.cloud.aws",
          "command.cloud.azure",
          "command.cloud.gcp",
          "command.database.mongodb",
          "command.database.mysql",
          "command.database.postgresql",
          "command.database.redis",
          "command.database.sqlite",
          "command.database.supabase",
          "command.dns.aws",
          "command.dns.azure",
          "command.dns.gcp",
          "command.email",
          "command.feature-flags",
          "command.framework.laravel",
          "command.github",
          "command.infrastructure-as-code",
          "command.kubernetes-operations",
          "command.load-balancer",
          "command.messaging.kafka",
          "command.messaging.nats",
          "command.messaging.rabbitmq",
          "command.monitoring",
          "command.payment",
          "command.platform.heroku",
          "command.platform.netlify",
          "command.platform.vercel",
          "command.remote.rsync",
          "command.remote.scp",
          "command.remote.ssh",
          "command.search.elasticsearch",
          "command.storage.aws-s3",
          "command.storage.azure-blob",
          "command.storage.google-cloud",
          "command.storage.minio"
        ],
        "external": [
          "command.blitcp",
          "command.mcp-filesystem",
          "command.mcp-instapods",
          "command.noodle",
          "command.ollama",
          "command.probe",
          "command.remote.essh",
          "command.repo2nb",
          "command.skill-base",
          "command.skill-sunset",
          "command.uivoid"
        ]
      }
    }
  },
  "cases": [
    {
      "id": "publish-current-directory",
      "command": "skb publish",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": [0]
    },
    {
      "id": "publish-relative-directory-with-metadata",
      "command": "skb publish ./my-skill --name \"My Skill\" --description \"A useful skill\" --changelog \"Initial release\"",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": [0]
    },
    {
      "id": "publish-global-options-before-subcommand",
      "command": "skb --name \"My Skill\" --changelog \"Release\" publish /tmp/my-skill",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": [0]
    },
    {
      "id": "publish-help-long-safe",
      "command": "skb publish --help",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "publish-help-short-safe",
      "command": "skb publish -h",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "publish-with-extra-flag-and-help-stays-reviewable",
      "command": "skb publish --name \"My Skill\" --help",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": [0]
    },
    {
      "id": "extension-inactive",
      "command": "skb publish ./my-skill",
      "enabled_extensions": [],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "permission-disabled",
      "command": "skb publish ./my-skill",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": ["command.skill-base.permission.publish"],
      "expected_action": "block",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": [0]
    },
    {
      "id": "skb-install-is-outside-publish-rule",
      "command": "skb install team-rules",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "skb-search-is-outside-publish-rule",
      "command": "skb search vue",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "skb-import-github-is-outside-publish-rule",
      "command": "skb import-github owner/repo",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "similar-subcommand-does-not-match",
      "command": "skb publishx ./my-skill",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    },
    {
      "id": "root-help-is-outside-publish-rule",
      "command": "skb --help",
      "enabled_extensions": ["command.skill-base"],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.skill-base.publish",
      "expected_effective_segments": []
    }
  ]
}
